{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yacc/ws/system-payload.schema.json",
  "title": "system payload",
  "description": "SPEC-002 MIG-002 capture @98db628. Baseline: SystemPayload in packages/common/src/websocket/types/SystemPayload.type.ts (contract type for the 7 SystemEvents constants).",
  "type": "object",
  "required": ["type", "timestamp"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["heartbeat", "connection_established", "reconnection", "error", "backlog_replay"]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "data": {"type": "object", "additionalProperties": true},
    "error": {
      "type": "object",
      "description": "Present when type is 'error'",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
