# =============================================================================
# Non-secret configuration for the YACC backend service in the local Compose
# stack (MIG-107 #473). Committed on purpose: nothing here is a secret.
#
# Secret-valued variables (bootstrap credential, token signing key, recovery
# key + hash, integration encryption master key, DB credentials, SendGrid
# key) come ONLY from the SOPS-encrypted artifact's decrypted output
# (deploy/compose/secrets/local.env — git-ignored).
#
# Origin values are the LOCAL origin this stack actually serves:
#   Traefik on 127.0.0.1:443 → https://localhost (self-signed local cert).
# No placeholder example.com, no public FQDN — public exposure is a later,
# separately founder-gated step (ADR-032).
# =============================================================================

# JSON structured logs (ADR-029 field parity) — production profile.
SPRING_PROFILES_ACTIVE=production
LOGGING_LEVEL_ROOT=info

# Embedded OIDC authorization server issuer (MIG-033): the local origin
# actually used; stamps AS-issued tokens and drives /.well-known discovery.
YACC_AUTH_AS_ISSUER=https://localhost

# Auth email (MIG-031): local SMTP policy; the SendGrid key variable itself
# is in the encrypted env file (empty locally, provider=smtp).
YACC_AUTH_EMAIL_PROVIDER=smtp
YACC_AUTH_EMAIL_FROM=no-reply@localhost
YACC_AUTH_EMAIL_BASE_URL=https://localhost

# Raw WebSocket (ADR-026): allowed Origin must mirror the local origin.
YACC_REALTIME_WS_ALLOWED_ORIGINS=https://localhost
