# =============================================================================
# Non-secret configuration for the YACC backend service in the STAGING Compose
# target (MIG-070d #487). Committed on purpose: nothing here is a secret.
#
# Separation rule (draft-finding 2 fix): the LOCAL target's file
# (deploy/compose/backend.env) is untouched — staging never mutates it. This
# file carries only staging non-secret values; secret values come ONLY from
# the operator-decrypted SOPS artifact
# (deploy/compose/secrets/staging.env — git-ignored; decrypted from
# staging.sops.env, see .docs/runbooks/compose-staging.md §3).
#
# This file is ALSO the compose interpolation source: every staging command
# passes it via --env-file (YACC_ORIGIN / YACC_DB_HOST / YACC_DB_NAME /
# YACC_BACKEND_IMAGE are interpolated by docker-compose.staging.yml).
# =============================================================================

# JSON structured logs (ADR-029 field parity) — production profile.
SPRING_PROFILES_ACTIVE=production
LOGGING_LEVEL_ROOT=info

# --- One origin rule (draft-finding 1 fix) -----------------------------------
# The public staging origin is set ONCE here; docker-compose.staging.yml
# derives YACC_AUTH_AS_ISSUER, YACC_AUTH_EMAIL_BASE_URL and
# YACC_REALTIME_WS_ALLOWED_ORIGINS from it, so they cannot drift apart.
# Verified live host (2026-11-12 evidence: /health/ready → 200). No trailing
# slash (draft-finding 5 fix).
YACC_ORIGIN=https://staging.riotingnerds.com

# --- Shared PostgreSQL server coordinates (non-secret) -----------------------
# The datasource URL is derived in docker-compose.staging.yml from these two
# names (container on the external `antpolis-database_database` network and
# database `yacc_client` — verified host facts, 2026-11-12). Credentials are
# NOT here: the operator's decrypted staging.env supplies POSTGRES_USER /
# POSTGRES_PASSWORD (the names application.yml binds).
YACC_DB_HOST=antpolis-database-postgres-1
YACC_DB_NAME=yacc_client

# --- Pinned image -------------------------------------------------------------
# Immutable CI tag of the exact commit being deployed — the operator edits
# this line per deploy (never `latest`, never a local build tag). The
# all-zero placeholder renders for validation but cannot pull or run.
# Example shape: ghcr.io/csim-sg/yacc/yacc-backend:sha-1a2b3c4d5e6f…
YACC_BACKEND_IMAGE=ghcr.io/csim-sg/yacc/yacc-backend:sha-0000000000000000000000000000000000000000

# --- Auth email ---------------------------------------------------------------
# Local SMTP policy, as deployed (the SendGrid key variable itself lives in
# the encrypted env file and stays empty unless SendGrid is adopted).
# SMTP relay reachability on the staging host is an operator-verified
# prerequisite (compose-staging.md P7); email sending is not exercised by the
# evidence procedure.
YACC_AUTH_EMAIL_PROVIDER=smtp
YACC_AUTH_EMAIL_FROM=no-reply@localhost
