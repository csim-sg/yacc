{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      // Or ["bun", "x", "my-mcp-command"]
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
      "environment": {
        "MY_ENV_VAR": "my_env_var_value",
      },
      
    },
    "daisyUI": {
     "type": "remote",
     "url": "https://gitmcp.io/saadeghi/daisyui"
   }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder"
        },
        "gpt-oss:20b": {
          "name": "GPT OSS 20B"
        }
      }
    }
  },
  "agent": {
    "fullstack-developer": {
      "mode": "primary",
      "prompt": "{file:./.opencode/prompts/fullstack-developer.md}",
      "tools": {
            "write": true,
            "edit": true,
            "bash": true,
            "read": true,
            "grep": true,
            "task": true,
            "webfetch": true,
            "todowrite": true,
            "todoread": true,
            "skill": true
      }
    },
    "product-owner": {
      "mode": "all",
      "prompt": "{file:./.opencode/prompts/product-owner.md}",
      "tools": {
            "write": true,
            "edit": true,
            "bash": false,
            "read": true,
            "grep": true,
            "task": true,
            "webfetch": true,
            "todowrite": true,
            "todoread": true,
            "skill": true
      },
      "permission": {
        "edit": {
          
          ".docs/*.md": "allow",
          "*": "deny",
        },
        "grep": {
          
          ".docs/*.md": "allow",
          "*": "deny",
        },
        "write": {
          
          ".docs/*.md": "allow",
"*": "deny",
        },
        "read": {
          
          ".docs/*.md": "allow",
"*": "deny",
        }
      }
    },
    "architect": {      
      "mode": "all",
      "prompt": "{file:./.opencode/prompts/architect.md}",
      "tools": {
            "write": true,
            "edit": true,
            "bash": false,
            "read": true,
            "grep": true,
            "task": true,
            "webfetch": true,
            "todowrite": true,
            "todoread": true,
            "skill": true
      },
      "permission": {
        "edit": {
          
          ".docs/*.md": "allow",
          "*": "deny",
        },
        "write": {
          
          ".docs/*.md": "allow",
"*": "deny",
        },
        "read": {
          
          ".docs/*.md": "allow",
"*": "deny",
        }
      },
    },
    "qa-tester": {      
      "mode": "all",
      "prompt": "{file:./.opencode/prompts/qa-tester.md}",
      "tools": {
            "write": true,
            "edit": true,
            "bash": true,
            "read": true,
            "grep": true,
            "task": true,
            "webfetch": true,
            "todowrite": true,
            "todoread": true,
            "skill": true
      }
    }
  }
}