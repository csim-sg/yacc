{
  "name": "yacc-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yet Another Chat Client - Omni-channel social inbox MVP",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @yacc/backend\" \"npm run dev -w @yacc/frontend\" \"npm run dev -w @yacc/frontend-angular\"",
    "build": "npm run build -w @yacc/common && npm run build -w @yacc/backend && npm run build -w @yacc/frontend && npm run build -w @yacc/frontend-angular",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.6",
    "@types/pino": "^7.0.4",
    "@types/pino-http": "^5.8.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@types/express-rate-limit": "^6.0.2",
    "express-rate-limit": "^8.2.1",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.0.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
