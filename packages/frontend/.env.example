# Frontend Environment Variables
#
# API base URL used by the single API client (src/lib/apiClient.ts).
# - Empty / unset  = same origin (default; matches the same-origin
#                    deployment topology — the Spring service has no CORS).
# - Local dev      = vite dev proxy relays /api, /oauth2 and /.well-known
#                    to VITE_API_URL (see vite.config.ts).
VITE_API_BASE_URL=

# Dev proxy target: the Java service (Spring, port 8080). Before the Java
# cutover this may point at the Node POC backend (:3000).
VITE_API_URL=http://localhost:8080

# Embedded OIDC authorization server (MIG-033). Empty issuer = same origin.
# The registered public SPA client id (yacc.auth.as.clients.*).
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=yacc-frontend

# WebSocket endpoint (WS adaptation is MIG-052 scope).
VITE_WS_URL=ws://localhost:8080
VITE_APP_URL=http://localhost:5173
