# YACC Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Server Configuration
# ============================================================================

# Node environment (development, test, production)
NODE_ENV=development

# Port to run the server on
PORT=3000

# Frontend URL for CORS and Socket.io configuration
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://yacc_user:yacc_password@localhost:5432/yacc_inbox

# Alternatively, you can specify individual components:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=yacc_inbox
# DB_USER=yacc_user
# DB_PASSWORD=yacc_password

# Database pool size (connections)
DB_POOL_SIZE=10

# ============================================================================
# Authentication & JWT (BetterAuth Bearer Plugin)
# ============================================================================

# Secret key for BetterAuth (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production

# Access Token TTL (seconds) - Default: 48 hours (172800 seconds)
ACCESS_TOKEN_TTL_SECONDS=172800

# Refresh Token TTL (seconds) - Default: 30 days (2592000 seconds)
REFRESH_TOKEN_TTL_SECONDS=2592000

# Password reset token expiry (hours)
PASSWORD_RESET_TOKEN_EXPIRY=24

# Legacy JWT config (keep for backwards compatibility during migration)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# ============================================================================
# Redis Configuration (for caching & message queue)
# ============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis password (if required)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# ============================================================================
# Email Configuration (for password resets, notifications)
# ============================================================================

# Email provider (nodemailer, sendgrid, mailgun, etc.)
EMAIL_PROVIDER=nodemailer

# SMTP Configuration (if using nodemailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yacc.local
SMTP_FROM_NAME=YACC Inbox

# SendGrid API Key (if using SendGrid)
SENDGRID_API_KEY=

# ============================================================================
# File Storage Configuration (Cloudflare R2 / AWS S3)
# ============================================================================

# Storage provider (r2, s3, local)
STORAGE_PROVIDER=local

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=yacc-inbox
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarecontent.com

# AWS S3 Configuration (alternative)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=yacc-inbox

# Local storage path (for development)
LOCAL_STORAGE_PATH=./uploads

# ============================================================================
# Telegram Integration
# ============================================================================

# Telegram Bot API Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram API ID and Hash (from https://my.telegram.org)
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash

# Telegram bot webhook URL (for receiving updates)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhooks/telegram

# ============================================================================
# IRC Integration
# ============================================================================

# IRC Network Configuration
IRC_NETWORKS=network1,network2

# IRC Network 1
IRC_NETWORK_1_NAME=libera
IRC_NETWORK_1_HOST=irc.libera.chat
IRC_NETWORK_1_PORT=6667
IRC_NETWORK_1_NICK=yacc-bot
IRC_NETWORK_1_PASSWORD=
IRC_NETWORK_1_CHANNELS=#support,#general

# IRC Network 2 (optional)
IRC_NETWORK_2_NAME=freenode
IRC_NETWORK_2_HOST=irc.freenode.net
IRC_NETWORK_2_PORT=6667
IRC_NETWORK_2_NICK=yacc-bot
IRC_NETWORK_2_PASSWORD=
IRC_NETWORK_2_CHANNELS=#help

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=text

# Log to file
LOG_FILE=./logs/app.log

# Log directory
LOG_DIR=./logs

# ============================================================================
# Audit Configuration
# ============================================================================

# Audit log retention (days)
AUDIT_RETENTION_DAYS=365

# Raw payload retention (days)
RAW_PAYLOAD_RETENTION_DAYS=7

# ============================================================================
# Rate Limiting (Phase 2)
# ============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=false

# Requests per minute (authenticated)
RATE_LIMIT_AUTH_RPM=100

# Requests per minute (unauthenticated)
RATE_LIMIT_UNAUTH_RPM=20

# ============================================================================
# Monitoring & Analytics (optional)
# ============================================================================

# Sentry error tracking
SENTRY_DSN=

# Datadog API Key
DATADOG_API_KEY=

# New Relic License Key
NEW_RELIC_LICENSE_KEY=

# ============================================================================
# Feature Flags (for gradual rollout)
# ============================================================================

# Enable/disable features
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_AUDIT_LOGGING_ENABLED=true
FEATURE_ROUTING_RULES_ENABLED=false
FEATURE_NOTIFICATIONS_ENABLED=false
FEATURE_ATTACHMENTS_ENABLED=false

# ============================================================================
# Development & Testing
# ============================================================================

# Enable CORS for all origins (development only!)
CORS_ALLOW_ALL=false

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Enable request logging
REQUEST_LOGGING_ENABLED=true

# Enable SQL query logging (Drizzle)
DRIZZLE_DEBUG=false

# ============================================================================
# Notes
# ============================================================================

# IMPORTANT: Never commit actual secrets to version control!
# - Use .env files only locally
# - Use environment variables on production servers
# - Use a secrets management tool (Vault, AWS Secrets Manager, etc.)

# Password Requirements:
# - Minimum 6 characters
# - Can contain letters, numbers, special characters

# Database Setup:
# 1. Create user: CREATE USER yacc_user WITH PASSWORD 'yacc_password';
# 2. Create database: CREATE DATABASE yacc_inbox OWNER yacc_user;
# 3. Grant privileges: GRANT ALL PRIVILEGES ON DATABASE yacc_inbox TO yacc_user;
# 4. Run migrations: npm run migrate

# JWT Secret Generation:
# - Unix/Mac: openssl rand -base64 32
# - Windows: Use an online JWT secret generator or install openssl

# Redis Setup:
# - Local: docker run -d -p 6379:6379 redis:latest
# - Or install from: https://redis.io/download

# Email Setup (Development):
# - Use MailHog: docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
# - Then access: http://localhost:8025

# Production Deployment:
# 1. Set NODE_ENV=production
# 2. Use strong JWT_SECRET
# 3. Enable HTTPS for FRONTEND_URL
# 4. Configure proper database backups
# 5. Set up error monitoring (Sentry, Datadog)
# 6. Enable rate limiting
# 7. Configure CDN for file storage
# 8. Set up logging aggregation (ELK, Datadog, etc.)
