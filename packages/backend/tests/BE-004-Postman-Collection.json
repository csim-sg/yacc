              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Forgot password with existing user email"
          },
          "response": []
        },
        {
          "name": "2.2 - Forgot Password (Non-Existent Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"nonexistent-user-9999@example.com\"}"
