            "url": {
              "raw": "http://localhost:3000/api/auth/forgot-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Forgot password with non-existent email (should still return 200)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Scenario 3: Token Expiration",
      "item": [
        {
          "name": "3.1 - Forgot Password (Capture Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/forgot-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Get token for expiration test (capture from console)"
          },
          "response": []
        },
        {
          "name": "3.3 - Reset Password with Expired Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\": \"EXPIRED_TOKEN_HERE\", \"newPassword\": \"ExpiredTest123!\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/reset-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Try to use expired token (should fail with generic error)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Scenario 4: Token Reuse Prevention",
      "item": [
        {
          "name": "4.1 - Forgot Password (Capture Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/forgot-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Get token for reuse test (capture from console)"
          },
          "response": []
        },
        {
          "name": "4.2 - First Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\": \"TOKEN_FROM_CONSOLE\", \"newPassword\": \"FirstReset123!\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/reset-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "reset-password"]
            },
            "description": "First password reset (should succeed)"
          },
          "response": []
        },
        {
          "name": "4.3 - Second Reset Attempt (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\": \"TOKEN_FROM_CONSOLE\", \"newPassword\": \"SecondReset456!\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/reset-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Reuse same token (should fail)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Scenario 5: Password Requirements Validation",
