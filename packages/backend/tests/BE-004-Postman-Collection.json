{
  "info": {
    "_postman_id": "be004-password-reset",
    "name": "BE-004 Password Reset Testing",
    "description": "Manual test collection for BE-004 password reset functionality",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Scenario 1: Valid Password Reset Flow",
      "item": [
        {
          "name": "1.1 - Forgot Password (Existing User)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/forgot-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Request password reset for existing user"
          },
          "response": []
        },
        {
          "name": "1.3 - Reset Password with Valid Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\": \"REPLACE_WITH_TOKEN_FROM_CONSOLE\", \"newPassword\": \"NewPassword123!\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/reset-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Complete password reset with valid token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Scenario 2: Email Enumeration Prevention",
      "item": [
        {
          "name": "2.1 - Forgot Password (Existing Email)",
          "request": {
