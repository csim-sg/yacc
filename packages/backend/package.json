{
  "name": "@yacc/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "clean": "rm -rf dist dist-tmp",
    "build:tsc": "tsc --outDir dist-tmp",
    "build:bundle": "tsx bundle-backend.ts",
    "build": "pnpm run clean && pnpm run build:tsc && pnpm run build:bundle",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "db:seed": "tsx scripts/seed-admin.ts",
    "db:fixtures": "tsx scripts/seed-test-fixtures.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "@better-auth/core": "^1.4.18",
    "@yacc/common": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.4.18",
    "bullmq": "^5.67.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.22.1",
    "ioredis": "^5.9.2",
    "irc": "^0.5.2",
    "irc-framework": "^4.14.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "socket-controllers": "^0.3.1",
    "socket.io": "^4.8.3",
    "typedi": "^0.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.32",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.10",
    "eslint": "^8.57.1",
    "happy-dom": "^20.5.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
