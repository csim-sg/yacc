# Compose local deployment (MIG-107 #473): decrypted SOPS output and local
# TLS material are never committed — the only committed secret artifact is
# the SOPS-encrypted *.sops.env file.
deploy/compose/secrets/*.env
!deploy/compose/secrets/*.sops.env
deploy/compose/tls/
